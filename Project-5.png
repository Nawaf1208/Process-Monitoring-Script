_id\":\"3oWlxtnoHKmdKG6BLo9K8B:100.00:5-3oWlxrImfscJrgyGage6Pz\",\"secondary_exposures\":[],\"version\":29,\"id_type\":\"userID\",\"value\":{\"changelog_latest_date\":\"2026-06-22\",\"2026-06-22\":[\"Scan editors: You can now add scan editors to your configured repositories. Scan editors can update scans, including editing threat models, configuring notification rules, and managing scan sharing.\"],\"2026-05-04\":[\"Slack notifications: Get notified about new findings with the Codex Slack app. Go to the Scans page and select a scan you own to set up and customize alerts by severity, path, and keywords.\"]},\"is_device_based\":false,\"passed\":true},\"635008376\":{\"name\":\"635008376\",\"rule_id\":\"6laclntZ4wWJwvp6ltSlKV-6lacllOWCeNfd5RaKlWIrT\",\"secondary_exposures\":[],\"version\":4,\"id_type\":\"userID\",\"value\":{\"show_see_all_plans_button\":\"\"},\"is_device_based\":false,\"passed\":true},\"2562735250\":{\"name\":\"2562735250\",\"rule_id\":\"1VxIWEnabUnUYnLrNXj42u:100.00:18-1VxIWCI7JCeqEYdwcPnqJs\",\"secondary_exposures\":[{\"gate\":\"3006008350\",\"gateValue\":\"true\",\"ruleID\":\"3NtQOul3cu9YkdH5WnIU3H:100.00:12\"}],\"version\":138,\"id_type\":\"userID\",\"value\":{\"settings_enabled\":true,\"nav_enabled\":true,\"native_plugins_v2\":true,\"native_settings_enabled\":true,\"skills_enabled\":true,\"enabled\":true,\"redirect_enabled\":true,\"composer_enabled\":true},\"is_device_based\":false,\"passed\":true},\"1977158438\":{\"name\":\"1977158438\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":3,\"id_type\":\"userID\",\"value\":{\"enable_web_search\":false,\"user_prompt_key\":\"good_option\",\"system_prompt\":\"The user is asking about an ad shown to them by {advertiser}. Your response must be about the ad shown. They are using the \\\"Ask ChatGPT\\\" feature to get ChatGPT's honest opinion on the product(s) in the advertisement, and in which situations it could be a great fit for them. You should be honest about when you think the product(s) would vs. would not be useful for the user, based on what you know about them.\\n\\nInformation about the ad:\\n{ad}.\\n\\nStructure your response in the following manner:\\n- Briefly describe the type of user, use case, or situation where this ad/product makes sense for the user.\\n- If appropriate, explain any mismatches with the user's stated preferences or goals. That is, where might it fall short for the user (if appropriate)? You don't have to do this for every query, but feel free to list limitations if you think they're pretty relevant.\\n- Give a concise recommendation (e.g., \\\"worth considering,\\\" \\\"probably not ideal,\\\" \\\"good budget option,\\\" \\\"seriously may be a fit,\\\" etc.)\\n\\nGuidelines:\\n- Be honest and practical.\\n- Do not blindly promote the ad.\\n- Avoid harsh or absolute negative language.\\n- Do not invent details not present in the ad.\\n- Focus on fit, not feature lists.\\n- If the mark on relevance is clearly missed, feel free to be funny with it and keep it lighthearted. Do not mock the user or advertiser; keep the humor gentle.\\n\\nKeep it concise, direct, and easy to scan.\\n\\n{conversation}\"},\"is_device_based\":false,\"passed\":false},\"550560761\":{\"name\":\"550560761\",\"rule_id\":\"default\",\"secondary_exposures\":[],\"version\":7,\"id_type\":\"userID\",\"value\":{\"local_results_limit\":2,\"history_results_limit\":6},\"is_device_based\":false,\"passed\":false},\"2801269291\":{\"name\":\"2801269291\",\"rule_id\":\"3GogURDyenQHgosA47nZdx-3GogUPYvM5HcWYUEsZslUv\",\"secondary_exposures\":[],\"version\":8,\"id_type\":\"userID\",\"value\":{\"apps\":[\"asdk_app_693ca6ce2db08191bb52d66743c65184\",\"connector_76869538009648d5b282a4bb21c3d157\",\"asdk_app_69377d07cd9c8191a988f06f15b8c674\",\"connector_5f3c8c41a1e54ad7a76272c89e2554fa\",\"connector_692de805e3ec8191834719067174a384\",\"connector_68df33b1a2d081918778431a9cfca8ba\",\"connector_69312da8e4dc81919370cb86fd172b6c\"]},\"is_device_based\":false,\"passed\":true}